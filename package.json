{
  "name": "aegis-detox",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --project tsconfig.base.json && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter mobile test:e2e",
    "knip": "knip",
    "build": "pnpm --filter web build && pnpm --filter mobile build",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile dev"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "knip": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
